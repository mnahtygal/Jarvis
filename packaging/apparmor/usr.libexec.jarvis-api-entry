# Repository-reviewed profile; install as /etc/apparmor.d/usr.libexec.jarvis-api-entry.

abi <abi/4.0>,

profile jarvis-api-entry /usr/libexec/jarvis-api-entry {
  allow all,
  network inet stream,
  network inet dgram,
  unix (create) type=stream,
  audit deny change_profile,
  audit deny userns create,

  /usr/libexec/jarvis-candidate-sandbox Cx -> candidate_userns,

  profile candidate_userns {
    allow all,
    audit deny change_profile,
    userns create,

    /usr/bin/unshare ix,
    /usr/bin/bwrap Px -> jarvis-api-entry//candidate_userns//candidate_runtime,

    profile candidate_runtime flags=(attach_disconnected.path=/run/jarvis-candidate-runtime/) {
      allow all,
      mount options=(rw rslave) -> /,
      mount fstype=tmpfs options=(rw nosuid nodev),
      mount options=(rw rbind),
      mount fstype=proc options=(rw nosuid nodev noexec),
      mount fstype=devpts options=(rw nosuid noexec),
      mount options=(remount ro bind),
      mount options=(rw rprivate),
      umount,
      pivot_root oldroot=/tmp/oldroot/ /tmp/,
      audit deny change_profile,
      audit deny userns create,
    }
  }
}
