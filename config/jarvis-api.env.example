# Jarvis API service environment example
#
# Copy these variable names into /etc/jarvis/jarvis-api.env and protect that
# deployed file as root:root mode 0600. Never commit, print, log, or share the
# real token. Use a unique, high-entropy token dedicated to the handheld.
#
# JARVIS_API_BIND_HOST accepts only 127.0.0.1, localhost, or ::1. Missing,
# empty, malformed, and non-loopback values safely fall back to 127.0.0.1.

JARVIS_HANDHELD_TOKEN=
JARVIS_API_BIND_HOST=127.0.0.1
