# HTTPS boundary for the Jarvis ESP32 handheld. This template intentionally
# exposes only GET /health plus POST /handheld/v1/chat and /handheld/v2/chat.
server {
    listen 443 ssl default_server;
    server_name 10.0.0.213;

    # These are deployed file paths, not certificate material. Adjust only if
    # the deployment uses an equivalent root-owned location.
    ssl_certificate     /etc/jarvis/pki/certs/jarvis-handheld-server.crt;
    ssl_certificate_key /etc/jarvis/pki/private/jarvis-handheld-server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 768;
    proxy_redirect off;

    # Defined in /etc/nginx/conf.d/jarvis-handheld-log-format.conf. This format
    # records only source, method, normalized path, status, bytes, and duration.
    access_log /var/log/nginx/jarvis-handheld-access.log jarvis_handheld;
    error_log  /var/log/nginx/jarvis-handheld-error.log warn;

    location = /health {
        if ($request_method != GET) { return 405; }

        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_pass http://127.0.0.1:5000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
    }

    location = /handheld/v1/chat {
        if ($request_method != POST) { return 405; }

        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 5s;
        proxy_pass http://127.0.0.1:5000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, rather than append to, untrusted client forwarding data.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
    }

    location = /handheld/v2/chat {
        if ($request_method != POST) { return 405; }

        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 5s;
        proxy_pass http://127.0.0.1:5000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, rather than append to, untrusted client forwarding data.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
    }

    location / {
        return 404;
    }
}
